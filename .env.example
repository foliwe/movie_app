# Shared app runtime
NODE_ENV=production
PORT=3000
WEB_PORT=3000

# PostgreSQL container
POSTGRES_DB=movieapp
POSTGRES_USER=movieapp
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Local host development uses localhost for Prisma/Next.js outside Docker.
DATABASE_URL=postgresql://movieapp:change-me@localhost:5432/movieapp

# Docker services use the Compose service name instead of localhost.
DATABASE_URL_DOCKER=postgresql://movieapp:change-me@postgres:5432/movieapp

# Local email delivery
# Set this to your public HTTPS origin in production.
APP_URL=http://127.0.0.1:3000
SMTP_HOST=127.0.0.1
SMTP_HOST_DOCKER=mailpit
SMTP_PORT=1025
SMTP_FROM=Mboko Reels <noreply@mbokoreels.local>
# Set this to a real inbox in production.
MOVIE_REQUEST_ADMIN_EMAIL=admin@example.com

# Cloudinary media management
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Production TLS / reverse proxy
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
